# WAAS auth token for CI / containers (optional).
# If set, m-aws ignores ~/.maroo/credentials.json.
# Get it after `m-aws login`, do NOT commit the real value.
WAAS_AUTH_TOKEN=

# Override defaults only if needed:
# WAAS_BASE_URL=https://testing.waas-dev.shardlab.io
# MAWS_FAUCET_URL=https://faucet.maroo.io/api/agent/sendToken
# MAROO_RPC_URL=
